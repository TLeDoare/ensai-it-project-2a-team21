# =============================================================
# Modèle de configuration Anonymia
# Copier ce fichier en .env (cp .env.example .env) puis remplir
# les valeurs. Ne JAMAIS pousser le .env sur GitHub.
# =============================================================

# --- LLM SSPCloud ---
# Adresse du serveur LLM (ne pas modifier)
LLM_BASE_URL=https://llm.lab.sspcloud.fr/api
# Clé API personnelle : chacun génère la sienne sur SSPCloud
SSPCLOUD_API_KEY=
# Modèle utilisé par le détecteur (ex. gemma4-26b-moe)
LLM_MODEL=gemma4-26b-moe

# --- Base PostgreSQL (valeurs dans le README du service Onyxia) ---
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DATABASE=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SCHEMA=anonymia

# --- Empreinte des documents (HMAC-SHA256, F4) ---
# Clé commune à toute l'équipe, à demander en privé. Ne jamais la régénérer,
# sinon les empreintes déjà enregistrées ne seront plus comparables.
DOC_HASH_SECRET=
