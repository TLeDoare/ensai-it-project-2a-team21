# Cible SSPCloud (par défaut)
LLM_BASE_URL=https://llm.lab.sspcloud.fr/api
SSPCLOUD_API_KEY=<clé personnelle>
LLM_MODEL=qwen3-6-35b-moe

# Cible Ollama local  : remplacer les trois lignes par
# LLM_BASE_URL=http://localhost:11434/v1
# SSPCLOUD_API_KEY=ollama
# LLM_MODEL=<nom du modèle installé en local>

# Remplacer <username> et <password> par les identifiants onyxia :
POSTGRES_HOST=postgresql-cnpg-168087-rw.user-<username>
POSTGRES_PORT=5432
POSTGRES_DATABASE=defaultdb
POSTGRES_USER=user-<username>
POSTGRES_PASSWORD=<password>
POSTGRES_SCHEMA=project

UVICORN=http://localhost:5000
BACKEND_TIMEOUT=5